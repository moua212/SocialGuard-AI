APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string      # python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg2://socialguard:socialguard@postgres:5432/socialguard
POSTGRES_PASSWORD=socialguard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPass1
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MIN=60
LOGIN_RATE_LIMIT_PER_MIN=10
RETENTION_DAYS=90
# Optional LLM explanation layer (never changes the ML score)
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
MLFLOW_TRACKING_URI=http://mlflow:5000
